# ==============================================================================
# DAU SECOND BRAIN - CẤU HÌNH BIẾN MÔI TRƯỜNG TRỰC DỤNG & AI
# ==============================================================================
# Sao chép tệp này thành .env.local trong thư mục web/ và điền cấu hình:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Cấu hình Google Gemini AI & Embedding
# ------------------------------------------------------------------------------
# API Key lấy tại Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 2. Cấu hình Tài khoản Admin & Sinh viên Demo (Authentication Bước 15)
# ------------------------------------------------------------------------------
# Tài khoản Admin hệ thống (Quyền Admin truy cập /admin)
ADMIN_EMAIL=admin@dau.edu.vn
ADMIN_PASSWORD=change-this-demo-password

# Tài khoản Sinh viên Demo (Quyền Student, truy cập /admin sẽ bị 403)
STUDENT_EMAIL=student@dau.edu.vn
STUDENT_PASSWORD=change-this-student-password

# Chuỗi bí mật ký Session Cookie HMAC-SHA256 (Phía Server)
AUTH_SECRET=dau_second_brain_session_secret_hmac_2026

# ------------------------------------------------------------------------------
# Ghi chú bảo mật:
# - Tệp .env.local ĐÃ ĐƯỢC .gitignore chặn lại, tuyệt đối không commit lên GitHub.
# - Không bao giờ đưa mật khẩu thật vào .env.example.
